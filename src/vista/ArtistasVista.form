<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="vista.ArtistasVista">
  <grid id="27dc6" binding="panelPrincipal" layout-manager="BorderLayout" hgap="10" vgap="10">
    <constraints>
      <xy x="20" y="20" width="1200" height="700"/>
    </constraints>
    <properties>
      <minimumSize width="800" height="600"/>
      <preferredSize width="1200" height="700"/>
    </properties>
    <border type="empty">
      <size top="10" left="10" bottom="10" right="10"/>
    </border>
    <children>
      <grid id="e8b5a" binding="topPanel" layout-manager="BorderLayout" hgap="10" vgap="10">
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="f6c3e" class="javax.swing.JLabel" binding="lblTituloPrincipal">
            <constraints border-constraint="West"/>
            <properties>
              <font name="Arial" size="20" style="1"/>
              <text value="Gestión de Artistas"/>
            </properties>
          </component>
          <grid id="a7d9f" binding="searchPanel" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="2">
            <constraints border-constraint="East"/>
            <properties/>
            <border type="none"/>
            <children>
              <component id="b8e4c" class="javax.swing.JLabel">
                <constraints/>
                <properties>
                  <text value="Buscar:"/>
                </properties>
              </component>
              <component id="c9f5d" class="javax.swing.JTextField" binding="txtBuscar">
                <constraints/>
                <properties>
                  <columns value="20"/>
                  <toolTipText value="Buscar por nombre artístico, real o país"/>
                </properties>
              </component>
              <component id="d0g6e" class="javax.swing.JButton" binding="btnBuscar">
                <constraints/>
                <properties>
                  <text value="Buscar"/>
                </properties>
              </component>
              <component id="btnActivos" class="javax.swing.JButton" binding="btnFiltrarActivos">
                <constraints/>
                <properties>
                  <text value="Ver Activos"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
      <grid id="f1h7g" binding="tablePanel" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="etched" title="Lista de Artistas"/>
        <children>
          <scrollpane id="g2i8h" binding="scrollPane">
            <constraints border-constraint="Center"/>
            <properties/>
            <border type="none"/>
            <children>
              <component id="h3j9i" class="javax.swing.JTable" binding="tableArtistas">
                <constraints/>
                <properties>
                  <rowHeight value="25"/>
                </properties>
              </component>
            </children>
          </scrollpane>
        </children>
      </grid>
      <grid id="i4k0j" binding="formPanel" layout-manager="GridLayoutManager" row-count="9" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="5" vgap="5">
        <margin top="10" left="10" bottom="10" right="10"/>
        <constraints border-constraint="East"/>
        <properties>
          <preferredSize width="350" height="600"/>
        </properties>
        <border type="etched" title="Formulario de Artista"/>
        <children>
          <component id="j5l1k" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="120" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <text value="Nombre Artístico:"/>
            </properties>
          </component>
          <component id="k6m2l" class="javax.swing.JTextField" binding="txtNombreArtistico">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="200" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="l7n3m" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Nombre Real:"/>
            </properties>
          </component>
          <component id="m8o4n" class="javax.swing.JTextField" binding="txtNombreReal">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="n9p5o" class="javax.swing.JLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Edad:"/>
            </properties>
          </component>
          <component id="o0q6p" class="javax.swing.JSpinner" binding="spinnerEdad">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="p1r7q" class="javax.swing.JLabel">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="País:"/>
            </properties>
          </component>
          <component id="q2s8r" class="javax.swing.JComboBox" binding="comboPais">
            <constraints>
              <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="r3t9s" class="javax.swing.JLabel">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Fecha Primera Obra:"/>
            </properties>
          </component>
          <component id="s4u0t" class="javax.swing.JTextField" binding="txtFechaPrimeraObra">
            <constraints>
              <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <toolTipText value="Formato: yyyy-MM-dd (ej: 2015-03-10)"/>
            </properties>
          </component>
          <component id="t5v1u" class="javax.swing.JLabel">
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Exposición Activa:"/>
            </properties>
          </component>
          <component id="u6w2v" class="javax.swing.JCheckBox" binding="checkExposicionActiva">
            <constraints>
              <grid row="5" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Tiene exposición activa"/>
            </properties>
          </component>
          <grid id="b3d9c" binding="buttonPanel" layout-manager="GridLayoutManager" row-count="3" column-count="2" same-size-horizontally="true" same-size-vertically="false" hgap="10" vgap="10">
            <margin top="20" left="10" bottom="10" right="10"/>
            <constraints>
              <grid row="7" column="0" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="c4e0d" class="javax.swing.JButton" binding="btnNuevo">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Nuevo"/>
                </properties>
              </component>
              <component id="d5f1e" class="javax.swing.JButton" binding="btnGuardar">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-13619152"/>
                  <foreground color="-1"/>
                  <text value="Guardar"/>
                </properties>
              </component>
              <component id="e6g2f" class="javax.swing.JButton" binding="btnActualizar">
                <constraints>
                  <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-12154296"/>
                  <foreground color="-1"/>
                  <text value="Actualizar"/>
                </properties>
              </component>
              <component id="f7h3g" class="javax.swing.JButton" binding="btnEliminar">
                <constraints>
                  <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-1499900"/>
                  <foreground color="-1"/>
                  <text value="Eliminar"/>
                </properties>
              </component>
              <component id="g8i4h" class="javax.swing.JButton" binding="btnLimpiar">
                <constraints>
                  <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Limpiar"/>
                </properties>
              </component>
            </children>
          </grid>
          <vspacer id="h9j5i">
            <constraints>
              <grid row="6" column="0" row-span="1" col-span="2" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
            </constraints>
          </vspacer>
          <vspacer id="spacer2">
            <constraints>
              <grid row="8" column="0" row-span="1" col-span="2" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
            </constraints>
          </vspacer>
        </children>
      </grid>
    </children>
  </grid>
</form>
